#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0

# Before network and firewall, so both consume the generated configuration.
START=18
USE_PROCD=1

start_service() {
	/usr/libexec/internet-apply boot
}

reload_service() {
	/usr/libexec/internet-apply reload
}

service_triggers() {
	procd_add_reload_trigger "onu-internet"
}
